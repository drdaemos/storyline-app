OPENAI_API_KEY=
OPENAI_PROJECT=
ANTHROPIC_API_KEY=
COHERE_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_APP_URL=
OPENROUTER_APP_TITLE=Storyline

# STORYLINE_MODEL=openrouter:provider/model
# STORYLINE_WORKSPACE=/path/to/workspace

# Auth Configuration
# AUTH_ENABLED=false: the web server has one local user working in STORYLINE_WORKSPACE (shared with the terminal UI).
# AUTH_ENABLED=true: every request must carry a Clerk session token (Authorization: Bearer <token>), and each user's
# stories live in STORYLINE_DATA_DIR/users/<user id>.
AUTH_ENABLED=false
CLERK_SECRET_KEY=
# Clerk instance PEM public key; with it session tokens are verified without a network call (optional).
# CLERK_JWT_KEY=
# Comma-separated origins allowed in a token's azp claim, e.g. https://storyline.example (optional).
# CLERK_AUTHORIZED_PARTIES=
# Frontend sign-in (read when the frontend is built or served by Vite); without it the frontend sends no token.
# VITE_CLERK_PUBLISHABLE_KEY=
# Where per-user workspaces are kept when AUTH_ENABLED=true (also: storyline serve --data-dir).
# STORYLINE_DATA_DIR=/path/to/data
# Built frontend to serve at / (default: static/ at the repository root).
# STORYLINE_STATIC_DIR=/path/to/static

# Database Configuration
# The memory system supports both SQLite (default) and PostgreSQL databases.
# Configure using either individual variables or a full DATABASE_URL.

# Use DATABASE_URL (takes precedence over individual variables)
# DATABASE_URL=sqlite:///path/to/database.db
# DATABASE_URL=postgresql://user:password@host:port/database

# If no database configuration is provided, defaults to SQLite with:
# - Database file: ./memory/conversations.db (contains both conversations and summaries)

# Logging Configuration
# LOG_TO_CONSOLE=true  # Set to "true" to enable console logging, "false" to log only to files (default: "false")
